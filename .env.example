# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Local dev: `npm run db:up` starts one on port 54329.
DATABASE_URL="postgresql://postgres@localhost:54329/agent_wallet"
# Used by integration tests (schema is dropped and recreated on every test run!).
TEST_DATABASE_URL="postgresql://postgres@localhost:54329/agent_wallet_test"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of the dashboard. Used for links in approval emails / push notifications.
APP_URL="http://localhost:3000"
# Port for the standalone agent API dev server (packages/api).
API_PORT=4000
# Shared secret the scheduler sends as `Authorization: Bearer ...` to /api/cron/expire.
CRON_SECRET="change-me-to-a-long-random-string"

# ─── Card issuing ────────────────────────────────────────────────────────────
# "mock" (default, in-memory test cards) or "stripe" (Stripe Issuing).
CARD_ISSUER="mock"
# Signing secret for mock issuer webhooks (dev only).
MOCK_ISSUER_WEBHOOK_SECRET="mock_webhook_secret"
# Stripe Issuing (only when CARD_ISSUER=stripe). Use test-mode keys until you're approved for live.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint pointing at /api/webhooks/issuer.
# Subscribe it to issuing_authorization.request, issuing_authorization.created, issuing_transaction.created.
STRIPE_WEBHOOK_SECRET=""
# Issuing cardholder all cards are issued to (create it in the Stripe dashboard; requires KYC).
STRIPE_ISSUING_CARDHOLDER_ID=""

# ─── Email (approval + security notifications) ───────────────────────────────
# Leave RESEND_API_KEY empty to print emails to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="Agent Wallet <wallet@yourdomain.com>"

# ─── Web push ────────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys. Empty = log pushes to console.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourdomain.com"

# ─── Tuning (optional; defaults shown) ───────────────────────────────────────
APPROVAL_TTL_MINUTES=15
CREDENTIAL_TTL_MINUTES=30
# How long a request may wait for a human decision before it lapses (24h).
PENDING_TTL_MINUTES=1440
# Clean purchases in a row before suggesting an auto-approve rule.
TRUST_MIN_STREAK=10
AGENT_RATE_LIMIT_PER_MINUTE=60

# ─── MCP over stdio only ─────────────────────────────────────────────────────
# The agent's API key, when running `npm run mcp:stdio` (or from Claude Desktop config).
AGENT_WALLET_API_KEY=""
