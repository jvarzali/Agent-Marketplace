# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Local dev: `npm run db:up` starts one on port 54329.
DATABASE_URL="postgresql://postgres@localhost:54329/agent_wallet"
# Used by integration tests (schema is dropped and recreated on every test run!).
TEST_DATABASE_URL="postgresql://postgres@localhost:54329/agent_wallet_test"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of the dashboard. Used for links in approval emails / push notifications.
APP_URL="http://localhost:3000"
# Port for the standalone agent API dev server (packages/api).
API_PORT=4000
# The dashboard runs the expiry sweep (lapse approvals, close unused cards) every minute itself.
# Set to "off" on serverless hosts and call /api/cron/expire from a scheduler instead.
EXPIRY_SWEEP="on"
# Shared secret the scheduler sends as `Authorization: Bearer ...` to /api/cron/expire.
CRON_SECRET="change-me-to-a-long-random-string"

# ─── Dashboard sign-in (Auth.js) ─────────────────────────────────────────────
# Signs session cookies. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Needed outside Vercel in production so Auth.js trusts the host header. Dev trusts it already.
# AUTH_TRUST_HOST=true
# Sign-in links are emailed with the same sender as approvals (RESEND_API_KEY / EMAIL_FROM
# below). Without RESEND_API_KEY the link is printed in the `npm run dev` log.

# ─── Card issuing ────────────────────────────────────────────────────────────
# "mock" (default, in-memory test cards), "privacy" (Privacy.com, real cards for personal use)
# or "stripe" (Stripe Issuing, business use).
CARD_ISSUER="mock"
# Signing secret for mock issuer webhooks (dev only).
MOCK_ISSUER_WEBHOOK_SECRET="mock_webhook_secret"
# Stripe Issuing (only when CARD_ISSUER=stripe). Test mode needs no Issuing application:
# put an sk_test_ key here, then run `npm run stripe:setup` (see README, "Stripe Issuing in test mode").
STRIPE_SECRET_KEY=""
# Signing secret for /api/webhooks/issuer. Locally: the whsec_ printed by `stripe listen`.
# A dashboard endpoint must subscribe to issuing_authorization.request,
# issuing_authorization.created and issuing_transaction.created.
STRIPE_WEBHOOK_SECRET=""
# Cardholder all cards are issued to. `npm run stripe:setup` creates one in test mode and fills this in.
STRIPE_ISSUING_CARDHOLDER_ID=""
# Financial account cards spend from (fa_...), on accounts using Stripe's newer money management.
# `npm run stripe:setup` finds it and fills this in; the wallet also looks it up if it's empty.
STRIPE_FINANCIAL_ACCOUNT=""
# Optional cardholder overrides for stripe:setup (default: your SHOPPER_* details, else the made-up test shopper).
# Stripe needs a phone number on the cardholder; it comes from SHOPPER_PHONE unless STRIPE_CARDHOLDER_PHONE is set.
# STRIPE_CARDHOLDER_PHONE=""
# STRIPE_CARDHOLDER_NAME=""
# STRIPE_BILLING_LINE1=""
# STRIPE_BILLING_CITY=""
# STRIPE_BILLING_STATE=""
# STRIPE_BILLING_POSTAL_CODE=""

# Name, email, phone and shipping address agents enter at checkout (get_shipping_details).
# Leave SHOPPER_NAME empty to use a built-in made-up person while cards are test cards
# (CARD_ISSUER=mock or a Stripe test key). Agents aren't told it's made up. With real cards,
# agents get nothing until you set these.
SHOPPER_NAME=""
SHOPPER_EMAIL=""
SHOPPER_PHONE=""
SHOPPER_ADDRESS_LINE1=""
SHOPPER_ADDRESS_LINE2=""
SHOPPER_ADDRESS_CITY=""
SHOPPER_ADDRESS_STATE=""
SHOPPER_ADDRESS_POSTAL_CODE=""
SHOPPER_ADDRESS_COUNTRY="US"
# The made-up person's email and phone default to reserved values (jordan.avery@example.com,
# +1 415-555-0123) that agents may recognize as fake. Set ones you own (e.g. a Gmail "+shop"
# address) to make them look real; store emails and texts for test checkouts then reach you.
# TEST_SHOPPER_NAME=""
# TEST_SHOPPER_EMAIL=""
# TEST_SHOPPER_PHONE=""

# How the agent gets the card after approval:
#   "agent"   get_purchase_status returns the card once and the agent types it in (default).
#   "browser" the agent calls fill_payment_details and the wallet types the card into the
#             checkout page itself, so the model never sees the number. Needs the shopping
#             browser (agents/browser/start-chrome.sh) running on this machine.
CARD_DELIVERY="browser"
# Chrome's remote debugging address for card filling (default http://127.0.0.1:9222).
# AGENT_BROWSER_CDP_URL="http://127.0.0.1:9222"
# Extra payment-provider hosts whose iframes may hold card fields (comma-separated).
# Shopify, Stripe, Braintree, Adyen, Square, PayPal and other common ones are built in.
# AGENT_BROWSER_PAYMENT_HOSTS=""

# Privacy.com (only when CARD_ISSUER=privacy). Needs a paid Privacy plan; key from app.privacy.com/api.
# Keep this key on the server only: never give it (or Privacy's MCP/CLI) to an agent.
PRIVACY_API_KEY=""
# Name and billing address on your Privacy account; given to the agent with each card for checkout.
PRIVACY_CARDHOLDER_NAME=""
PRIVACY_BILLING_LINE1=""
PRIVACY_BILLING_LINE2=""
PRIVACY_BILLING_CITY=""
PRIVACY_BILLING_STATE=""
PRIVACY_BILLING_POSTAL_CODE=""
PRIVACY_BILLING_COUNTRY="US"
# Optional: SINGLE_USE (default) or MERCHANT_LOCKED; a specific funding source; another API base.
PRIVACY_CARD_TYPE=""
PRIVACY_FUNDING_TOKEN=""
PRIVACY_API_BASE=""
# Point Privacy's transaction webhook at {public url}/api/webhooks/issuer to check every charge.

# ─── Email (approval + security notifications) ───────────────────────────────
# Leave RESEND_API_KEY empty to print emails to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="Agent Wallet <wallet@yourdomain.com>"

# ─── Web push ────────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys. Empty = log pushes to console.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourdomain.com"

# ─── Tuning (optional; defaults shown) ───────────────────────────────────────
APPROVAL_TTL_MINUTES=15
CREDENTIAL_TTL_MINUTES=30
# How long a request may wait for a human decision before it lapses (24h).
PENDING_TTL_MINUTES=1440
# Clean purchases in a row before suggesting an auto-approve rule.
TRUST_MIN_STREAK=10
AGENT_RATE_LIMIT_PER_MINUTE=60

# ─── MCP over stdio only ─────────────────────────────────────────────────────
# The agent's API key, when running `npm run mcp:stdio` (or from Claude Desktop config).
AGENT_WALLET_API_KEY=""
